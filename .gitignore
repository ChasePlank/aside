# Tooling and build output. None of this belongs in the repository: it is either reproducible from source or
# machine-specific. The JVM crash logs are the interesting entry - a JavaFX media crash in this sandbox writes
# hs_err_pid*.log next to whatever was running, and it was being left untracked and unnoticed.
node_modules/
out/
classes/
*.log
hs_err_pid*.log
replay_pid*.log
saves/

# Python bytecode caches from tools/*.py. RUNNING one as a script does not create one - IMPORTING one does, and that
# is how this appeared: a debug session imported check-readme-stories.py to read its own regexes, and the tree then
# reported a modification that was not one. Same entry, same reason, as the crash logs above.
__pycache__/
